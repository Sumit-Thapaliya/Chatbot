# Reference values only — your real config goes in the .env file.
# app.py loads .env automatically; no `export` commands needed.
# Free key: https://console.groq.com/keys  (no credit card needed)

GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional
GROQ_SYSTEM=You are a warm, precise assistant. Prefer short paragraphs and concrete examples.
HOST=0.0.0.0
PORT=8000
