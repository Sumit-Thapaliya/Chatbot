# Reference values only — your real config goes in the .env file.
# app.py loads .env automatically; no `export` commands needed.
# Free key: https://console.groq.com/keys  (no credit card needed)
#
# ERP behaviour is defined in two sibling files (not in .env):
#   system_prompt.txt    default School ERP Assistant system prompt
#   knowledge_base.txt   chatbot KB only (PDF sections 4-7)
# Edit those files and restart the server.

GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional. Empty = use system_prompt.txt; a value here overrides that file.
GROQ_SYSTEM=
HOST=127.0.0.1
PORT=8000

# Public widget protection. For a public deployment set HOST=0.0.0.0
# and serve over HTTPS (a render.yaml Blueprint is included).
CHAT_RPM=60
WIDGET_RPM=30
WIDGET_MAX_TOKENS=1024

# Other free-tier model IDs you can try:
#   openai/gpt-oss-120b      ~500 tok/s, strong reasoning
#   openai/gpt-oss-20b       ~1000 tok/s, fastest
#   llama-3.1-8b-instant     ~560 tok/s
